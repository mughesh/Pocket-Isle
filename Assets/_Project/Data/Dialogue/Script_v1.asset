    once: 0
    objective: 1
    priority: 1
    note: 'Nov 3: any direction, dots count 4 tiles walked'
    target: ghost
    validWhile: canWalk
    context: outside & !battle
    kind: 1
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Swipe your thumb along your finger to walk.
