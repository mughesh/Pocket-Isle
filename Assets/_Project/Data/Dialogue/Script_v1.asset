%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5e5160043a3c8cd4cb17d02e9809f8d9, type: 3}
  m_Name: Script_v1
  m_EditorClassIdentifier: Diorama.Runtime::Diorama.DialogueScript
  triggers:
  - id: intro.shard
    once: 1
    priority: 1
    note: only if the shard isn't touched within 3 s
    target: shard
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Oh! Something's here. Touch it?
  - id: intro.arrive
    once: 1
    priority: 1
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Oh! You're awake. Hello, big one.
    - speaker: 0
      speakerName: Spirit
      text: I'm a Lantern Spirit. A small one. Very small.
  - id: intro.world
    once: 1
    priority: 1
    note: 
    target: rim
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The world broke into floating pieces. This is one of them.
    - speaker: 0
      speakerName: Spirit
      text: Hold its rocky edge to move it. Put it wherever feels comfy.
  - id: intro.starter
    once: 1
    priority: 1
    note: 
    target: starterPods
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Every guardian needs an Isling friend. Pick one!
  - id: starter.kilnpot
    once: 0
    priority: 1
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Kilnpot! Warm as a fresh-baked pot.
  - id: starter.pebbloop
    once: 0
    priority: 1
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Pebbloop! Bubbly, and very round.
  - id: starter.pufflet
    once: 0
    priority: 1
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Pufflet! Light as a cloud, twice as fluffy.
  - id: intro.explorer
    once: 1
    priority: 1
    note: 
    target: tile:21,22
    lines:
    - speaker: 0
      speakerName: Spirit
      text: See the little explorer? Swipe your thumb along your finger to walk.
    - speaker: 0
      speakerName: Spirit
      text: Tap your thumb to stop. Or just look at a spot and pinch.
  - id: intro.statue
    once: 1
    priority: 1
    note: first time within ~3 tiles of the statue
    target: landmark:statue
    lines:
    - speaker: 0
      speakerName: Spirit
      text: That statue... it has three empty holes.
    - speaker: 0
      speakerName: Spirit
      text: I feel like I know it. Strange.
  - id: gate.sealed
    once: 0
    priority: 2
    note: walking into or pinching a sealed gate
    target: gate:last
    lines:
    - speaker: 0
      speakerName: Spirit
      text: This one's still asleep. Maybe later.
  - id: gate.fire.first
    once: 1
    priority: 2
    note: first time the fire gate comes into the window
    target: gate:fire
    lines:
    - speaker: 0
      speakerName: Spirit
      text: That arch is warm. It leads somewhere.
  - id: realm.cinderwood.first
    once: 1
    priority: 2
    note: first arrival in Cinderwood
    target: tile:30,29
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Cinderwood. The fire here has gone quiet.
    - speaker: 0
      speakerName: Spirit
      text: Let's find out why.
  - id: hub.return.first
    once: 1
    priority: 2
    note: first time back in the hub from a realm
    target: landmark:statue
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Home again. The statue looks... different?
  - id: tut.grass
    once: 1
    priority: 1
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Tall grass rustles when an Isling is hiding in it.
  - id: tut.pond
    once: 1
    priority: 1
    note: first time next to water
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Face the water and tap. Something might bite!
  - id: pod.first
    once: 1
    priority: 1
    note: encounter start
    target: leadPod
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Grab your friend's pod from the rim and toss it in!
  - id: battle.first
    once: 1
    priority: 1
    note: 
    target: runes
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Look at a rune and pinch. Or just poke it.
  - id: battle.types
    once: 1
    priority: 1
    note: first super or not-very effective hit
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Water beats Fire. Fire beats Wind. Wind beats Water.
  - id: battle.win.first
    once: 1
    priority: 1
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: You did it! Your friend is getting stronger.
  - id: battle.lose.first
    once: 1
    priority: 1
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Everyone's tired. Let's rest at the shrine.
  - id: capture.first
    once: 1
    priority: 1
    note: first time the wild HP bar is red
    target: cradle
    lines:
    - speaker: 0
      speakerName: Spirit
      text: It's weak now. Grab the big pod and flick it!
  - id: capture.locked
    once: 1
    priority: 1
    note: a pod thrown above red shatters
    target: cradle
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Weaken it first!
  - id: capture.dazed.first
    once: 1
    priority: 1
    note: first dazed wild Isling
    target: cradle
    lines:
    - speaker: 0
      speakerName: Spirit
      text: It's dazed. Quick, a pod!
  - id: capture.success.first
    once: 1
    priority: 1
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: A new Isling! It's in your pods now.
  - id: party.full
    once: 1
    priority: 1
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Your pods are full. New friends will wait for you at the Hearth Lodge.
  - id: evolve.first
    once: 1
    priority: 1
    note: first evolution
    target: nearPad
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Look at that! They've grown into something new.
  - id: shrine.first
    once: 1
    priority: 1
    note: first time a shrine comes into the window
    target: shrine
    lines:
    - speaker: 0
      speakerName: Spirit
      text: A Hearth Shrine! Warm your hand over the flame.
  - id: lodge.first
    once: 1
    priority: 1
    note: first time inside the Hearth Lodge; the lodge hint chain starts, step 7c
    target: lodgeCenter
    lines:
    - speaker: 0
      speakerName: Spirit
      text: This is the Hearth Lodge. Islings you've caught rest here.
  - id: lodge.inspect
    once: 1
    priority: 1
    note: 'chain 2: waits for an inspect, comes back after 15 s'
    target: lodgeIsling
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Look at one and pinch to see how it's doing.
  - id: lodge.take
    once: 1
    priority: 1
    note: chain 3, after the first inspect; then the gold moves to a rim socket
    target: pedestal
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Pick it up and set it in a pod on the rim to bring it along.
  - id: lodge.leave
    once: 1
    priority: 1
    note: chain 4, after the first swap
    target: rimPod
    lines:
    - speaker: 0
      speakerName: Spirit
      text: To leave one here, toss its pod onto the floor.
  - id: lodge.exit
    once: 1
    priority: 1
    note: chain 5, after chain 4 or 30 s
    target: lodgeDoor
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The door takes you back outside.
  - id: lodge.last
    once: 0
    priority: 1
    note: the last rim pod refuses to leave
    target: leadPod
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Keep at least one Isling with you!
  - id: gate.first
    once: 1
    priority: 1
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: A Shard Gate. It leads to another piece of the world.
    - speaker: 0
      speakerName: Spirit
      text: Step in when you're ready.
  - id: rare.first
    once: 1
    priority: 1
    note: first gold sparkle
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Ooh, sparkly! That one's rare.
  - id: cw.arrive
    once: 1
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Cinderwood... it used to glow all year round.
    - speaker: 0
      speakerName: Spirit
      text: The leaves have gone grey. It's so cold.
  - id: cw.village
    once: 1
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The kilns are cold. Nobody's baking. That's never happened.
  - id: cw.springs
    once: 1
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Even the hot springs are only lukewarm.
  - id: cw.log
    once: 1
    priority: 2
    note: blocked by the fallen log
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: A fallen log. Too heavy for the little one.
    - speaker: 0
      speakerName: Spirit
      text: But not for you. Reach in and lift it!
  - id: cw.log.done
    once: 0
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Strong hands!
  - id: cw.temple
    once: 1
    priority: 2
    note: first time at the temple door
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The forge temple. Something big is breathing in there.
  - id: cw.bellows
    once: 1
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: These bellows feed the forge. Squeeze your hand, open, squeeze.
  - id: cw.brazier
    once: 0
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: 'One lit! (then: Two! / All three!)'
  - id: cw.door
    once: 0
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The door's opening...
  - id: cw.keeper.meet
    once: 0
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 1
      speakerName: Hearthstag
      text: Stay back! If I share the fire, it will go out forever.
    - speaker: 0
      speakerName: Spirit
      text: He's not mean. He's scared.
    - speaker: 0
      speakerName: Spirit
      text: Let's calm him down.
  - id: cw.keeper.shield
    once: 1
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: His crown blocks everything. Maybe water can crack it?
  - id: cw.keeper.shield.break
    once: 0
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: It cracked! Now's our chance!
  - id: cw.keeper.win
    once: 0
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 1
      speakerName: Hearthstag
      text: ...It's warm. The forest is warm again.
    - speaker: 1
      speakerName: Hearthstag
      text: I was so afraid of the dark. Thank you, guardian.
    - speaker: 1
      speakerName: Hearthstag
      text: Take this shard. Mend what broke.
  - id: cw.restored
    once: 1
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Look! Cinderwood is glowing again!
  - id: cw.shard.dock
    once: 1
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The island's getting bigger. Did you feel that?
  - id: statue.shard.1
    once: 0
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The statue's warmer. And I feel... brighter?
  - id: statue.shard.2
    once: 0
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Two shards. I can almost remember something.
  - id: statue.shard.3
    once: 0
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Three! Something's waking up...
  - id: heart.wake
    once: 0
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 2
      speakerName: Heart
      text: ...Little light. You found your way back.
    - speaker: 0
      speakerName: Spirit
      text: You... I know you. I'm part of you, aren't I?
    - speaker: 2
      speakerName: Heart
      text: The world broke, and so did I. Show me it can be whole.
  - id: heart.win
    once: 0
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 2
      speakerName: Heart
      text: You've grown strong, little light. And you, guardian.
    - speaker: 0
      speakerName: Spirit
      text: I'll miss you, big one. Come and visit, okay?
    - speaker: 0
      speakerName: Spirit
      text: I'll be right here. In the middle of everything.
  - id: end
    once: 0
    priority: 2
    note: 
    target: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: (glows, slots into the Heart's forehead)
  idleHints:
  - speaker: 0
    speakerName: Spirit
    text: Your Islings get stronger every battle.
  - speaker: 0
    speakerName: Spirit
    text: The other gates lead to water and wind. Just saying.
  - speaker: 0
    speakerName: Spirit
    text: Psst. Rare ones hide in tall grass.
  - speaker: 0
    speakerName: Spirit
    text: You can move the island anytime. Grab the edge.
