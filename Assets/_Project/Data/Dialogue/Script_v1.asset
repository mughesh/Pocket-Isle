%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5e5160043a3c8cd4cb17d02e9809f8d9, type: 3}
  m_Name: Script_v1
  m_EditorClassIdentifier: Diorama.Runtime::Diorama.DialogueScript
  triggers:
  - id: intro.shard
    once: 1
    priority: 1
    note: only if the shard isn't touched within 3 s
    target: shard
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Something's here. Touch it?
  - id: intro.arrive
    once: 1
    priority: 1
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Hello, big one! I'm a Lantern Spirit.
  - id: intro.world
    once: 1
    priority: 1
    note: 
    target: rim
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: This little island is yours. Grab its rocky edge to move it.
  - id: intro.starter
    once: 1
    priority: 1
    note: 
    target: starterPods
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Pick an Isling friend!
  - id: starter.kilnpot
    once: 0
    priority: 1
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Kilnpot! Warm as a fresh-baked pot.
  - id: starter.pebbloop
    once: 0
    priority: 1
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Pebbloop! Bubbly, and very round.
  - id: starter.pufflet
    once: 0
    priority: 1
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Pufflet! Light as a cloud, twice as fluffy.
  - id: intro.statue
    once: 1
    priority: 1
    note: first time within ~3 tiles of the statue
    target: landmark:statue
    validWhile: '!tutorial'
    lines:
    - speaker: 0
      speakerName: Spirit
      text: That statue has three empty holes... The world broke into floating pieces.
    - speaker: 0
      speakerName: Spirit
      text: I feel like I know it.
  - id: lesson.pinch
    once: 0
    priority: 1
    note: 'step 9h, after `intro.arrive`: the ghost pinches beside your own hand'
    target: 
    validWhile: tutorial
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Tap your thumb and finger together. Like this!
  - id: lesson.move.again
    once: 0
    priority: 1
    note: 
    target: rim
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Grab the rocky edge and slide it.
  - id: lesson.starter.again
    once: 0
    priority: 1
    note: 
    target: starterPods
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Look at one and pinch, or grab it.
  - id: lesson.walk
    once: 0
    priority: 1
    note: 
    target: ghost
    validWhile: canWalk
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Slide your thumb along your finger to walk.
  - id: lesson.walk.again
    once: 0
    priority: 1
    note: 
    target: ghost
    validWhile: canWalk
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Thumb along your finger. Like this!
  - id: lesson.walk.help
    once: 0
    priority: 1
    note: 
    target: ghost
    validWhile: canWalk
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Or look at a spot and pinch.
  - id: lesson.stop
    once: 0
    priority: 1
    note: 
    target: ghost
    validWhile: canWalk
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Swipe to walk, then tap your thumb to stop.
  - id: lesson.stop.again
    once: 0
    priority: 1
    note: 
    target: ghost
    validWhile: canWalk
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Swipe, then tap to stop.
  - id: lesson.look
    once: 0
    priority: 1
    note: 
    target: goldTile
    validWhile: canWalk
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Look at the glowing spot and pinch.
  - id: lesson.look.again
    once: 0
    priority: 1
    note: 
    target: goldTile
    validWhile: canWalk
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The glowing spot. Look, then pinch!
  - id: lesson.grass
    once: 0
    priority: 1
    note: 
    target: landmark:firstGrass
    validWhile: canWalk
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Islings hide in tall grass. Let's peek!
  - id: lesson.grass.again
    once: 0
    priority: 1
    note: 
    target: landmark:firstGrass
    validWhile: canWalk
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Follow the gold tiles into the tall grass.
  - id: lesson.send.again
    once: 0
    priority: 1
    note: 
    target: leadPod
    validWhile: battle
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Toss your friend's pod onto the island!
  - id: lesson.rune.again
    once: 0
    priority: 1
    note: 
    target: nearestRune
    validWhile: battle
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Poke a rune!
  - id: lesson.catch.again
    once: 0
    priority: 1
    note: 
    target: cradle
    validWhile: battle
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Grab the big pod and flick it!
  - id: lesson.twohands
    once: 0
    priority: 1
    note: step 8c, once after the first battle
    target: islandRim
    validWhile: '!battle'
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Use both hands to turn or resize the island.
  - id: lesson.hands
    once: 0
    priority: 1
    note: 
    target: 
    validWhile: tutorial
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Show me your hands!
  - id: praise.nice
    once: 0
    priority: 1
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Nice!
  - id: praise.like
    once: 0
    priority: 1
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Just like that!
  - id: praise.perfect
    once: 0
    priority: 1
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Perfect!
  - id: gate.sealed
    once: 0
    priority: 2
    note: walking into or pinching a sealed gate
    target: gate:last
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: This one's still asleep. Maybe later.
  - id: gate.fire.first
    once: 1
    priority: 2
    note: first time the fire gate comes into the window
    target: gate:fire
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: That arch is warm. It leads somewhere.
  - id: realm.cinderwood.first
    once: 1
    priority: 2
    note: 'first arrival in Cinderwood; step 9a: the first ember grass by the gate'
    target: landmark:firstGrass
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Cinderwood. The fire here has gone quiet.
    - speaker: 0
      speakerName: Spirit
      text: Let's find out why.
  - id: hub.return.first
    once: 1
    priority: 2
    note: first time back in the hub from a realm
    target: landmark:statue
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Home again. The statue looks... different?
  - id: tut.grass
    once: 1
    priority: 1
    note: 
    target: 
    validWhile: encounters
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Tall grass rustles when an Isling is hiding in it.
  - id: tut.pond
    once: 1
    priority: 1
    note: first time next to water
    target: 
    validWhile: encounters & !battle
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Face the water and tap. Something might bite!
  - id: pod.first
    once: 1
    priority: 1
    note: encounter start
    target: leadPod
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Grab your friend's pod from the rim and toss it in!
  - id: battle.first
    once: 1
    priority: 1
    note: 
    target: nearestRune
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Poke a rune to attack!
  - id: battle.types
    once: 1
    priority: 1
    note: first super or not-very effective hit
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Water beats Fire. Fire beats Wind. Wind beats Water.
  - id: battle.win.first
    once: 1
    priority: 1
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: You did it! Your friend is getting stronger.
  - id: battle.lose.first
    once: 1
    priority: 1
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Everyone's tired. Let's rest at the shrine.
  - id: capture.first
    once: 1
    priority: 1
    note: first time the wild HP bar is red
    target: cradle
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: It's weak now. Grab the big pod and flick it!
  - id: capture.locked
    once: 1
    priority: 1
    note: a pod thrown above red shatters
    target: cradle
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Weaken it first!
  - id: capture.dazed.first
    once: 1
    priority: 1
    note: first dazed wild Isling
    target: cradle
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: It's dazed. Quick, a pod!
  - id: capture.success.first
    once: 1
    priority: 1
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: A new Isling! It's in your pods now.
  - id: party.full
    once: 1
    priority: 1
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Your pods are full. New friends will wait for you at the Hearth Lodge.
  - id: evolve.first
    once: 1
    priority: 1
    note: first evolution
    target: nearPad
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Look at that! They've grown into something new.
  - id: shrine.first
    once: 1
    priority: 1
    note: first time a shrine comes into the window
    target: shrine
    validWhile: '!tutorial'
    lines:
    - speaker: 0
      speakerName: Spirit
      text: A Hearth Shrine! Warm your hand over the flame.
  - id: shrine.near
    once: 1
    priority: 1
    note: 'step 8c: first time the explorer stands next to one'
    target: shrine
    validWhile: '!tutorial'
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Warm your hand over the flame.
  - id: lodge.first
    once: 1
    priority: 1
    note: first time inside the Hearth Lodge; the lodge hint chain starts, step 7c
    target: lodgeCenter
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: This is the Hearth Lodge. Islings you've caught rest here.
  - id: lodge.inspect
    once: 1
    priority: 1
    note: 'chain 2: waits for an inspect, comes back after 15 s'
    target: lodgeIsling
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Look at one and pinch to see how it's doing.
  - id: lodge.take
    once: 1
    priority: 1
    note: chain 3, after the first inspect; then the gold moves to a rim socket
    target: pedestal
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Pick it up and set it in a pod on the rim to bring it along.
  - id: lodge.leave
    once: 1
    priority: 1
    note: chain 4, after the first swap
    target: rimPod
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: To leave one here, toss its pod onto the floor.
  - id: lodge.exit
    once: 1
    priority: 1
    note: chain 5, after chain 4 or 30 s
    target: lodgeDoor
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The door takes you back outside.
  - id: lodge.first.empty
    once: 1
    priority: 1
    note: 'step 8c: first visit with nobody in the lodge; the empty-lodge chain starts'
    target: lodgeCenter
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: This is the Hearth Lodge. Islings you leave here rest by the fire.
  - id: lodge.toss
    once: 1
    priority: 1
    note: 'empty chain 2: waits for a pod let go on the floor; ghost toss'
    target: rimPod
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Toss a pod onto the floor to let one rest here.
  - id: lodge.inspect.one
    once: 1
    priority: 1
    note: empty chain 3, after it pops out; then lodge.take, lodge.exit
    target: lodgeIsling
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Look at it and pinch to see how it's doing.
  - id: lodge.last
    once: 0
    priority: 1
    note: the last rim pod refuses to leave
    target: leadPod
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Keep at least one Isling with you!
  - id: gate.first
    once: 1
    priority: 1
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: A Shard Gate. It leads to another piece of the world.
    - speaker: 0
      speakerName: Spirit
      text: Step in when you're ready.
  - id: rare.first
    once: 1
    priority: 1
    note: first gold sparkle
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Ooh, sparkly! That one's rare.
  - id: xp.first
    once: 1
    priority: 1
    note: 'step 9f: the first XP after a win'
    target: nearPad
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Your Islings learn from every battle. Watch them grow!
  - id: steambara.first
    once: 1
    priority: 1
    note: 'step 9f: the first wild Steambara'
    target: wildPad
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: A water Isling, visiting the springs! Water beats fire...
  - id: menu.first
    once: 1
    priority: 1
    note: 'step 9g: a few calm seconds after the lessons end, never in a battle'
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Palm up and pinch with your left hand any time to pause.
  - id: cw.arrive
    once: 1
    priority: 2
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Cinderwood... it used to glow all year round.
    - speaker: 0
      speakerName: Spirit
      text: The leaves have gone grey. It's so cold.
  - id: cinder.village.first
    once: 1
    priority: 2
    note: 'step 9a: first time the explorer comes near the village plaza'
    target: landmark:plaza
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: A kiln village. The kilns are cold... everyone's gone quiet.
  - id: cinder.springs.first
    once: 1
    priority: 2
    note: first time near a pool
    target: landmark:springs
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Hot springs! Well, warm-ish. Not much steam.
  - id: cinder.log.first
    once: 1
    priority: 2
    note: first time near the fallen log
    target: landmark:log
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: A huge log blocks the path. Too heavy for the explorer...
  - id: cinder.temple.first
    once: 1
    priority: 2
    note: first time near the forge door; past the log, so from 9b
    target: landmark:temple
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: A forge in the cliff. The fire came from here.
  - id: cinder.ruins.first
    once: 1
    priority: 2
    note: first time in the kiln ruins
    target: landmark:ruins
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Old kilns. Something glazed is moving in the grass...
  - id: cinder.log.hands
    once: 1
    priority: 2
    note: 'step 9b: right after cinder.log.first; the ghost shows the lift'
    target: puzzle:cinder.log
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Maybe your big hands could move it?
  - id: cinder.log.done
    once: 1
    priority: 2
    note: 'step 9b: the log set down on a ledge, the trail open'
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: You're strong! Let's go on.
  - id: cw.temple
    once: 1
    priority: 2
    note: first time at the temple door
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The forge temple. Something big is breathing in there.
  - id: cinder.bellows.first
    once: 1
    priority: 2
    note: 'step 9b: first time the bellows are in reach; the ghost pokes the pad'
    target: puzzle:cinder.bellows
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Bellows! Poke them to send heat to the braziers.
  - id: cinder.brazier.one
    once: 0
    priority: 2
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: One!
  - id: cinder.brazier.two
    once: 0
    priority: 2
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Two!
  - id: cinder.brazier.three
    once: 0
    priority: 2
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Three!
  - id: cinder.forge.open
    once: 1
    priority: 2
    note: 'step 9b: all three braziers lit, the door glows and opens'
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The forge is waking up!
  - id: cinder.hall.first
    once: 1
    priority: 2
    note: 'step 9b: first time inside the Forge Hall; Hearthstag comes in 9c'
    target: hallKeeper
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Something huge sleeps here... not yet.
  - id: cinder.keeper.first
    once: 1
    priority: 2
    note: 'step 9c: first time in the Forge Hall; then the Keeper battle'
    target: hearthstag
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: It's scared... the fire is trapped inside it.
    - speaker: 0
      speakerName: Spirit
      text: Let's calm it down. Gently!
  - id: keeper.shield.first
    once: 1
    priority: 2
    note: first blocked hit
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Its crown shields it! Water breaks it, or keep chipping away.
  - id: keeper.shield.broken.first
    once: 1
    priority: 2
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The shield's down. Now!
  - id: keeper.phase2
    once: 1
    priority: 2
    note: below half HP
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: It's fighting the fear. Keep going!
  - id: cinder.keeper.win
    once: 1
    priority: 2
    note: it kneels and calms
    target: hearthstag
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: It wasn't angry. It was scared, holding all the fire in.
  - id: cinder.shard.take
    once: 1
    priority: 2
    note: the fire shard floats to the player
    target: fireShard
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The fire shard! Take it.
  - id: cinder.restored
    once: 1
    priority: 2
    note: the restoration wave outside
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Cinderwood is warm again!
  - id: cw.flame
    once: 0
    priority: 2
    note: lesson at the kiln village's shrine, its flame nearly out; chip "Cup it!"
    target: puzzle:cw.flame
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The village flame is fading! Keep it warm with your hands.
  - id: cw.flame.cold
    once: 1
    priority: 2
    note: trying to rest at the shrine before it's rekindled
    target: shrine
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: It's too weak to rest by. Warm it up first!
  - id: cw.flame.done
    once: 1
    priority: 2
    note: 'the flame rekindled: the warmth rolls over the plaza'
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: It's burning! Look, the whole village is waking up.
  - id: cw.lanterns
    once: 0
    priority: 2
    note: lesson at the smoky hollow; chip "Touch them!"
    target: puzzle:cw.hollow
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: It's too dark to pass. Light the lanterns!
  - id: cw.lanterns.done
    once: 1
    priority: 2
    note: 'every lantern lit: the smoke burns off the path'
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The smoke's burning away! The path is clear.
  - id: cw.ember
    once: 0
    priority: 2
    note: lesson at the forge's ember vent, before the bellows; chip "Palm up!"
    target: puzzle:cw.ember
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Carry an ember to the forge. Gently!
  - id: cw.forge.cold
    once: 0
    priority: 2
    note: the bellows pumped while the firebox is cold; at most every 8 s
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The forge is stone cold. It needs a spark first.
  - id: cw.ember.done
    once: 1
    priority: 2
    note: 'the ember tipped into the firebox: it roars'
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: It's roaring! Now the bellows can blow.
  - id: gate.wind.first
    once: 1
    priority: 2
    note: first time the wind gate comes into the window, once it leads somewhere
    target: gate:wind
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Listen... no wind through this tunnel at all.
  - id: realm.galewick.first
    once: 1
    priority: 2
    note: first arrival in Galewick
    target: landmark:firstGrass
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Galewick... it's never this quiet.
    - speaker: 0
      speakerName: Spirit
      text: The grass isn't even swaying.
  - id: gw.village.first
    once: 1
    priority: 2
    note: first time near the village plaza
    target: landmark:plaza
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Windmills, and not one sail turning.
  - id: gw.mill.first
    once: 1
    priority: 2
    note: first time by the big mill and the ditch
    target: landmark:mill
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The bridge is up. That big mill must lower it.
  - id: gw.kites.first
    once: 1
    priority: 2
    note: first time in the kite field
    target: landmark:kites
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Kites, lying in the grass. Nobody to fly them.
  - id: gw.ridge.first
    once: 1
    priority: 2
    note: first time near the ridge path
    target: landmark:ridge
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: A cloud sits right on the path. Stuck, like everything.
  - id: gw.tower.first
    once: 1
    priority: 2
    note: first time near the wind tower
    target: landmark:tower
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The wind tower. Its vanes should be spinning.
  - id: gw.rare.first
    once: 1
    priority: 2
    note: first time in the rare grass
    target: landmark:rare
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: This grass feels different. Something odd floats here.
  - id: gw.mill
    once: 0
    priority: 2
    note: lesson at the big mill; chip "Flick!"
    target: puzzle:gw.mill
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The mill is stuck. Give its sails a flick!
  - id: gw.mill.done
    once: 1
    priority: 2
    note: 'three flicks: the sails keep turning, the drawbridge comes down'
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: There it goes! The bridge is coming down.
  - id: gw.kites
    once: 0
    priority: 2
    note: lesson in the kite field; chip "Pull it up!"
    target: puzzle:gw.kites
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Kites! Lift one up into the sky.
  - id: gw.kites.one
    once: 0
    priority: 2
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: One!
  - id: gw.kites.two
    once: 0
    priority: 2
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Two!
  - id: gw.kites.three
    once: 0
    priority: 2
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: All three!
  - id: gw.gust
    once: 0
    priority: 2
    note: lesson at the cloud bank; chip "Sweep!"
    target: puzzle:gw.clouds
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: This cloud is stuck. Sweep your open hand fast over the island!
  - id: gw.gust.done
    once: 1
    priority: 2
    note: the last puff blown off the ridge path
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The path is clear! Feel that breeze?
  - id: gw.tower.kites
    once: 0
    priority: 2
    note: at the tower door with fewer than three kites
    target: landmark:tower
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The tower needs all three kites.
  - id: gw.tower.open
    once: 1
    priority: 2
    note: the kites tie onto the crown, the vanes turn
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The kites caught the wind. The door is opening!
  - id: gw.meet.kitelet
    once: 1
    priority: 2
    note: 'step 10c: the first wild Kitelet'
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: A Kitelet! It wants to fly, but there's no wind.
  - id: gw.meet.zeppelope
    once: 1
    priority: 2
    note: 'step 10c: the rare Zeppelope'
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: A Zeppelope! It's drifting... it never lands!
  - id: gw.keeper.knots
    once: 0
    priority: 2
    note: lesson in the tower hall; chip "Pull apart!"
    target: galeowl
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: It's all tangled up! Pull the knots apart.
  - id: gw.keeper.meet
    once: 1
    priority: 2
    note: 'all three knots undone: it shakes free and flares up'
    target: galeowl
    validWhile: 
    lines:
    - speaker: 1
      speakerName: Galeowl
      text: Stay still! If the wind blows, the pieces blow away!
    - speaker: 0
      speakerName: Spirit
      text: It's scared. Let's calm it down!
  - id: gw.keeper.shield
    once: 1
    priority: 2
    note: the Gust Wall goes up the first time
    target: galeowl
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: A wall of wind! Fire should break it.
  - id: gw.keeper.shield.break
    once: 1
    priority: 2
    note: 
    target: galeowl
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The wall is down. Now!
  - id: gw.keeper.win
    once: 1
    priority: 2
    note: it calms and bows
    target: galeowl
    validWhile: 
    lines:
    - speaker: 1
      speakerName: Galeowl
      text: I held the wind so nothing else would fly away.
    - speaker: 1
      speakerName: Galeowl
      text: But a still world is a stuck world.
    - speaker: 1
      speakerName: Galeowl
      text: Thank you, guardian. Let it blow.
  - id: gw.shard.take
    once: 1
    priority: 2
    note: 'step 10e: the wind shard floats out of the window to the player'
    target: windShard
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The wind shard! Grab it.
  - id: gw.restored
    once: 1
    priority: 2
    note: the restoration wave from the tower
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Feel that? Galewick is breathing again!
  - id: hub.shard.first
    once: 1
    priority: 2
    note: 'step 9c: in the hub holding a shard'
    target: statueSocket
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Put the shard in the statue. Something's calling it.
  - id: hub.shard.placed
    once: 1
    priority: 2
    note: the shard locks in
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: I... feel warmer. Strange.
  - id: hub.shard.more
    once: 1
    priority: 2
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Two more shards are out there.
  - id: statue.two
    once: 1
    priority: 2
    note: 'step 10e: the second shard locks into the statue'
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Two pieces home. It's almost awake...
  - id: statue.shard.1
    once: 0
    priority: 2
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The statue's warmer. And I feel... brighter?
  - id: statue.shard.2
    once: 0
    priority: 2
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Two shards. I can almost remember something.
  - id: statue.shard.3
    once: 0
    priority: 2
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Three! Something's waking up...
  - id: heart.wake
    once: 0
    priority: 2
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 2
      speakerName: Heart
      text: ...Little light. You found your way back.
    - speaker: 0
      speakerName: Spirit
      text: You... I know you. I'm part of you, aren't I?
    - speaker: 2
      speakerName: Heart
      text: The world broke, and so did I. Show me it can be whole.
  - id: heart.win
    once: 0
    priority: 2
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 2
      speakerName: Heart
      text: You've grown strong, little light. And you, guardian.
    - speaker: 0
      speakerName: Spirit
      text: I'll miss you, big one. Come and visit, okay?
    - speaker: 0
      speakerName: Spirit
      text: I'll be right here. In the middle of everything.
  - id: end
    once: 0
    priority: 2
    note: 
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: (glows, slots into the Heart's forehead)
  - id: quick.gift
    once: 1
    priority: 2
    note: after the capture lesson, in the hub; two pods fly from the Spirit to the
      rim
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: The road to Cinderwood is long. Take two friends with you!
  - id: quick.gate
    once: 1
    priority: 2
    note: 'right after the gift: the Spirit points at the fire gate'
    target: gate:fire
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Bring back the fire shard!
  - id: quick.end
    once: 1
    priority: 2
    note: the fire shard locks into the statue; then the Keep exploring / Title runes
    target: 
    validWhile: 
    lines:
    - speaker: 0
      speakerName: Spirit
      text: You woke the first piece of the world!
    - speaker: 0
      speakerName: Spirit
      text: Thank you for playing the Quick Journey.
  idleHints:
  - speaker: 0
    speakerName: Spirit
    text: Your Islings get stronger every battle.
  - speaker: 0
    speakerName: Spirit
    text: The other gates lead to water and wind. Just saying.
  - speaker: 0
    speakerName: Spirit
    text: Psst. Rare ones hide in tall grass.
  - speaker: 0
    speakerName: Spirit
    text: You can move the island anytime. Grab the edge.
