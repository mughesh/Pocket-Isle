%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5e5160043a3c8cd4cb17d02e9809f8d9, type: 3}
  m_Name: Script_v1
  m_EditorClassIdentifier: Diorama.Runtime::Diorama.DialogueScript
  triggers:
  - id: intro.shard
    once: 1
    objective: 1
    priority: 1
    note: only if the shard isn't touched within 3 s
    target: shard
    validWhile: 
    context: hub
    kind: 1
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Something's here. Touch it?
      context: 
  - id: intro.arrive
    once: 1
    objective: 0
    priority: 1
    note: 
    target: 
    validWhile: 
    context: hub
    kind: 2
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Hello, big one! I'm a Lantern Spirit.
      context: 
  - id: lesson.move
    once: 1
    objective: 1
    priority: 1
    note: 'step 14i: the move lesson''s line, was `intro.world`; chip "Grab a corner"
      in 14j; the ghost pinches a corner and moves it'
    target: rim
    validWhile: 
    context: outside
    kind: 1
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Grab a corner, then move me wherever is comfy.
      context: 
  - id: intro.starter
    once: 1
    objective: 1
    priority: 1
    note: 
    target: starterPods
    validWhile: 
    context: hub
    kind: 1
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Pick an Isling friend!
      context: 
  - id: starter.kilnpot
    once: 0
    objective: 0
    priority: 1
    note: 
    target: 
    validWhile: 
    context: hub
    kind: 0
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Kilnpot! Warm as a fresh-baked pot.
      context: 
  - id: starter.pebbloop
    once: 0
    objective: 0
    priority: 1
    note: 
    target: 
    validWhile: 
    context: hub
    kind: 0
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Pebbloop! Bubbly, and very round.
      context: 
  - id: starter.pufflet
    once: 0
    objective: 0
    priority: 1
    note: 
    target: 
    validWhile: 
    context: hub
    kind: 0
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Pufflet! Light as a cloud, twice as fluffy.
      context: 
  - id: intro.statue
    once: 1
    objective: 0
    priority: 1
    note: first time within ~3 tiles of the statue
    target: landmark:statue
    validWhile: '!tutorial'
    context: hub
    kind: 0
    lines:
    - speaker: 0
      speakerName: Spirit
      text: That statue has three empty holes... The world broke into floating pieces.
      context: 
    - speaker: 0
      speakerName: Spirit
      text: I feel like I know it.
      context: 
  - id: lesson.pinch
    once: 0
    objective: 1
    priority: 1
    note: 'step 9h, after `intro.arrive`: the ghost pinches beside your own hand'
    target: ghost
    validWhile: tutorial
    context: outside
    kind: 1
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Tap your thumb and finger together. Like this!
      context: 
  - id: lesson.pinch.once
    once: 0
    objective: 1
    priority: 1
    note: 'step 14a: after the first of the two pinches; chip "Pinch again"'
    target: ghost
    validWhile: tutorial
    context: outside
    kind: 1
    lines:
    - speaker: 0
      speakerName: Spirit
      text: Nice! Once more.
      context: 
  - id: lesson.pinch.done
    once: 0
    objective: 0
    priority: 1
    note: 'step 14a: the pinch lesson''s praise'
